{
 "$defs": {
  "Agg": {
   "additionalProperties": false,
   "properties": {
    "agg": {
     "description": "Combine over all nodes with an influencing link into the computed node",
     "enum": [
      "sum",
      "max",
      "min",
      "count"
     ],
     "title": "Agg",
     "type": "string"
    },
    "attribute": {
     "title": "Attribute",
     "type": "string"
    },
    "empty": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "integer"
      }
     ],
     "default": 0,
     "description": "Result when no node is linked",
     "title": "Empty"
    }
   },
   "required": [
    "agg",
    "attribute"
   ],
   "title": "Agg",
   "type": "object"
  },
  "Case": {
   "additionalProperties": false,
   "properties": {
    "case": {
     "description": "Ordered; first true \"when\" wins; last branch must be \"otherwise\"",
     "items": {
      "$ref": "#/$defs/CaseBranch"
     },
     "title": "Case",
     "type": "array"
    }
   },
   "required": [
    "case"
   ],
   "title": "Case",
   "type": "object"
  },
  "CaseBranch": {
   "additionalProperties": false,
   "properties": {
    "when": {
     "anyOf": [
      {
       "const": "otherwise",
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "type": "integer"
      },
      {
       "type": "boolean"
      },
      {
       "type": "string"
      },
      {
       "$ref": "#/$defs/Ref"
      },
      {
       "$ref": "#/$defs/Src"
      },
      {
       "$ref": "#/$defs/Agg"
      },
      {
       "$ref": "#/$defs/Op"
      },
      {
       "$ref": "#/$defs/Case"
      },
      {
       "type": "null"
      }
     ],
     "title": "When"
    },
    "then": {
     "title": "Then",
     "type": "string"
    }
   },
   "required": [
    "when",
    "then"
   ],
   "title": "CaseBranch",
   "type": "object"
  },
  "Claim": {
   "additionalProperties": false,
   "properties": {
