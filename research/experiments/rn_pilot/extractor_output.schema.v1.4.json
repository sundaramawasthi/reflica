    },
    "human": {
     "description": "The rule as written in the text",
     "title": "Human",
     "type": "string"
    },
    "role": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Role"
    },
    "when_linked": {
     "anyOf": [
      {
       "items": {
        "type": "string"
