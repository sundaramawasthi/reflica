     "type": "string"
    },
    "attribute": {
     "title": "Attribute",
     "type": "string"
    },
    "machine": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "integer"
      },
      {
       "type": "boolean"
      },
      {
       "type": "string"
      },
      {
       "$ref": "#/$defs/Ref"
      },
      {
       "$ref": "#/$defs/Src"
      },
      {
       "$ref": "#/$defs/Agg"
